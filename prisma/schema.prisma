// ReplyAI — AI Customer Support Automation Platform
// Multi-tenant schema: Organizations -> Users + Chatbots -> Conversations -> Messages
//
// Database: Turso (libSQL) — SQLite-compatible, edge-deployed.
// Connection is handled via the @prisma/adapter-libsql driver adapter
// (see src/lib/db.ts). The schema provider stays "sqlite" because
// Turso speaks the SQLite wire protocol.

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy & Auth ───────────────────────────────────────────────

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  plan            String   @default("FREE") // FREE | STARTER | PRO | SCALE
  users           User[]
  chatbots        Chatbot[]
  contacts        Contact[]
  cannedResponses CannedResponse[]
  webhooks        Webhook[]
  tags            Tag[]
  connections     PlatformConnection[]
  scheduledMessages ScheduledMessage[]
  automationRules AutomationRule[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String       @default("OWNER") // OWNER | ADMIN | AGENT
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]
  assignedTo   Conversation[] @relation("AssignedAgent")
  notes        Note[]
  connections     PlatformConnection[]
  scheduledMessages ScheduledMessage[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Chatbot & Knowledge ──────────────────────────────────────────

model Chatbot {
  id              String          @id @default(cuid())
  orgId           String
  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  welcomeMessage  String          @default("Hi! How can I help you today?")
  persona         String          @default("friendly") // friendly | professional | concise | playful
  systemPrompt    String?
  primaryColor    String          @default("#6366f1")
  status          String          @default("ACTIVE") // ACTIVE | PAUSED
  position        String          @default("bottom-right")
  conversations   Conversation[]
  knowledge       KnowledgeDoc[]
  faqs            FAQ[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model KnowledgeDoc {
  id         String   @id @default(cuid())
  chatbotId  String
  chatbot    Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  title      String
  content    String
  sourceType String   @default("TEXT") // TEXT | FAQ | URL | FILE
  createdAt  DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  chatbotId String
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())
}

// ─── Conversations ────────────────────────────────────────────────

model Conversation {
  id           String    @id @default(cuid())
  chatbotId    String
  chatbot      Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  visitorId    String
  visitorName  String?
  visitorEmail String?
  status       String    @default("AI") // AI | HUMAN | CLOSED
  channel      String    @default("WIDGET")
  satisfaction Int?
  summary      String?
  assignedToId String?
  assignedTo   User?     @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     Message[]
  tags         ConversationTag[]
  notes        Note[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // VISITOR | AI | AGENT
  content        String
  createdAt      DateTime     @default(now())
}

// ─── Internal Notes (private, team-only) ──────────────────────────

model Note {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─── Contacts / Leads ─────────────────────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  source    String   @default("WIDGET")
  notes     String?
  createdAt DateTime @default(now())
}

model CannedResponse {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     String
  content   String
  shortcut  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Webhooks ─────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url       String
  events    String   // JSON-encoded array of event types
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Tags / Labels ────────────────────────────────────────────────

model Tag {
  id            String            @id @default(cuid())
  orgId         String
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  color         String            @default("violet") // violet | emerald | amber | fuchsia | rose | sky
  conversations ConversationTag[]
  createdAt     DateTime          @default(now())

  @@unique([orgId, name])
}

model ConversationTag {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt     DateTime     @default(now())

  @@unique([conversationId, tagId])
}

// ─── Multi-Platform Scheduler ────────────────────────────────────
// Stores OAuth tokens for each connected platform (Facebook, Instagram,
// WhatsApp, LinkedIn, etc.). Tokens are encrypted at rest by the app
// layer (src/lib/platforms/_crypto.ts) before being persisted here.

model PlatformConnection {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId           String   // the user who authorized the connection
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform         String   // FACEBOOK | INSTAGRAM | WHATSAPP | LINKEDIN | TWITTER | EMAIL
  accountId        String   // platform-side account id (page id, ig user id, waba id, etc.)
  accountName      String   // human-readable (e.g. "Acme Inc. Facebook Page")
  accountHandle    String?  // optional (e.g. "@acme")
  accessTokenEnc   String   // encrypted access token
  refreshTokenEnc  String?  // encrypted refresh token (if platform supports)
  tokenExpiresAt   DateTime?
  scopes           String   // JSON-encoded array of granted scopes
  status           String   @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED | PENDING
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scheduledMessages ScheduledMessage[]

  @@unique([orgId, platform, accountId])
  @@index([orgId, platform])
  @@index([status])
}

model ScheduledMessage {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId           String   // the user who created the scheduled message
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId     String
  connection       PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform         String   // denormalized for fast querying (matches connection.platform)
  recipientId      String?  // platform-side recipient id (psid, ig user id, wa phone, li person urn)
  recipientHandle String?  // human-readable recipient (e.g. "@jane", "+1...555")
  content          String   // the message body (plain text or platform-formatted)
  mediaUrl        String?
  scheduledFor     DateTime // when to dispatch
  status           String   @default("PENDING") // PENDING | QUEUED | SENT | FAILED | CANCELLED
  attempts         Int      @default(0)
  lastError        String?
  sentAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId, status])
  @@index([status, scheduledFor])
  @@index([connectionId])
}

// ─── Automation Rules Engine ─────────────────────────────────────
// Rules let users define "When [trigger] on [platform], if [condition],
// then [action]". Triggers fire from inbound webhooks (FB/IG/WA/Google).
// Actions can be: AI_REPLY (generate + send), CANNED_REPLY (send fixed
// message), ESCALATE (mark conversation for human), NOTIFY (push to inbox),
// SCHEDULE_FOLLOWUP (enqueue a ScheduledMessage N minutes later).

model AutomationRule {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  status           String   @default("ACTIVE") // ACTIVE | PAUSED | DRAFT
  triggerPlatform  String   // FACEBOOK | INSTAGRAM | WHATSAPP | LINKEDIN | GOOGLE | WEB
  triggerEvent     String   // MESSAGE_RECEIVED | COMMENT_RECEIVED | MENTION | EMAIL_RECEIVED | CALENDAR_STARTING
  conditions       String   // JSON: [{ "field": "text", "op": "contains", "value": "pricing" }, ...]
  actionType       String   // AI_REPLY | CANNED_REPLY | ESCALATE | NOTIFY | SCHEDULE_FOLLOWUP
  actionConfig     String   // JSON: { "persona": "professional", "cannedId": "...", "delayMin": 30, "escalateTo": "..." }
  priority         Int      @default(100) // higher = evaluated first
  matchedCount     Int      @default(0)
  lastMatchedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  logs             AutomationLog[]

  @@index([orgId, status, triggerPlatform, triggerEvent])
  @@index([orgId, status])
}

model AutomationLog {
  id               String   @id @default(cuid())
  orgId            String
  ruleId           String
  rule             AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggerPlatform  String
  triggerEvent     String
  // Snapshot of the inbound payload that fired (PSID, message text, etc.).
  // Truncated to 500 chars per field to limit PII retention.
  inboundSummary   String
  actionType       String
  outcome          String   @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  outboundPreview  String?  // first 200 chars of generated/sent reply
  errorMessage     String?
  latencyMs       Int?
  createdAt        DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([ruleId, createdAt])
  @@index([outcome])
}
