# ─────────────────────────────────────────────────────────────
# ReplyAI — Environment Variables
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# LOCAL DEV (SQLite):
#   Path is resolved relative to the prisma/ directory.
#   This creates db/custom.db at the project root.
DATABASE_URL="file:../db/custom.db"

# PRODUCTION (Vercel + Postgres):
#   1. Provision a Postgres database (Neon / Supabase / Vercel Postgres).
#   2. Change `provider = "sqlite"` to `provider = "postgresql"`
#      in prisma/schema.prisma.
#   3. Set DATABASE_URL to your Postgres connection string:
# DATABASE_URL="postgresql://user:password@host:5432/replyai?sslmode=require"
#   4. Run `bun run db:push` once to create tables.

# ── NextAuth ──────────────────────────────────────────────────
# Generate a secret: `openssl rand -base64 32` or `bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Public URL of your app. On Vercel, set this to your deployment URL.
NEXTAUTH_URL="http://localhost:3000"

# ── Realtime (optional) ───────────────────────────────────────
# The Socket.io mini-service (port 3001) is only available in the
# sandbox dev environment. On Vercel, leave this unset — the app
# gracefully falls back to 10s polling for conversation updates.
# Set to "1" to explicitly enable, "0" to disable.
# NEXT_PUBLIC_REALTIME_ENABLED="1"

# ── AI (z-ai-web-dev-sdk) ─────────────────────────────────────
# The SDK auto-configures via the environment. No keys needed in
# the sandbox. For other environments, follow the z-ai-web-dev-sdk
# setup instructions.
