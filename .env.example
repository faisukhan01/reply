# ─────────────────────────────────────────────────────────────
# ReplyAI — Environment Variables (template)
# Copy this file to `.env` and fill in your values.
# NEVER commit your real `.env` file — it is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Database (Turso / libSQL) ─────────────────────────────────
# Create a free DB at https://turso.tech → copy URL + Auth Token.
# This is the ONLY database ReplyAI uses. No Postgres, no MySQL, no Redis.
DATABASE_URL="libsql://your-db-your-username.aws-region.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token-here"

# ── Auth (JWT cookie session, jose HS256) ───────────────────────
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Public URL of your app. On Vercel, set this to your deployment URL.
NEXTAUTH_URL="http://localhost:3000"

# The public base URL of your deployment — used to build OAuth
# redirect URLs and webhook registration URLs. Must match the
# canonical URL Vercel serves (no trailing slash).
APP_PUBLIC_URL="https://reply-beryl.vercel.app"

# ── Realtime (optional, off on Vercel) ──────────────────────────
# The Socket.io mini-service (port 3001) is only available in the
# sandbox dev environment. On Vercel, leave this as "0" — the app
# gracefully falls back to 10s polling for conversation updates.
NEXT_PUBLIC_REALTIME_ENABLED="0"

# ─────────────────────────────────────────────────────────────────
# INTEGRATIONS
# ─────────────────────────────────────────────────────────────────

# ── Meta (Facebook + Instagram + WhatsApp) ─────────────────────
# One Meta app covers all three platforms.
#
# How to get (easiest path):
#   1. https://developers.facebook.com → My Apps → Create App
#   2. App type: "Business" → name it "ReplyAI"
#   3. App Settings → Basic → copy App ID + App Secret
#   4. Add products: WhatsApp, Messenger, Instagram Graph API
#   5. WhatsApp → API Setup tab → copy Phone Number ID + temp Token
#   6. Make up any random string for META_WEBHOOK_VERIFY_TOKEN
#      (you'll enter the same string when registering the webhook)
#
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Same as FACEBOOK_APP_SECRET (used for X-Hub-Signature-256 verification)
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="replyai_verify_CHANGE_ME"
# WhatsApp Business Cloud API (from WhatsApp > API Setup tab)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCESS_TOKEN=""

# ── Google Cloud (Gmail + Calendar + Business Profile) ────────
# One Google Cloud project covers all three.
#
# How to get (easiest path):
#   1. https://console.cloud.google.com → Create Project "ReplyAI"
#   2. APIs & Services → Library → enable Gmail API + Google Calendar API
#   3. APIs & Services → OAuth consent screen → External
#         App name: ReplyAI, support email: yours
#         Scopes: gmail.readonly, gmail.send, calendar.readonly, calendar.events
#         Test users: add your email
#   4. Credentials → Create Credentials → OAuth client ID → Web app
#         Authorized redirect URIs:
#           https://reply-beryl.vercel.app/api/connections/GOOGLE/callback
#           http://localhost:3000/api/connections/GOOGLE/callback
#   5. Copy Client ID + Client Secret
#
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: for Gmail push notifications (Pub/Sub). Leave blank to poll.
GOOGLE_PUBSUB_TOPIC=""
GOOGLE_PUBSUB_VERIFIER_EMAIL=""

# ── LinkedIn (optional, leave blank to disable) ─────────────────
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── Scheduler ───────────────────────────────────────────────────
# Vercel Hobby doesn't support cron. Use an external cron service
# (cron-job.org / UptimeRobot / EasyCron) to POST every 5 minutes
# to https://reply-beryl.vercel.app/api/scheduler/dispatch with
# the header `x-cron-secret: <CRON_SECRET>`.
# Generate: `openssl rand -hex 32`
CRON_SECRET=""

# ── AI ──────────────────────────────────────────────────────────
# ReplyAI uses the ZAI SDK (z-ai-web-dev-sdk) for AI replies.
# No API key needed in env — configured automatically by the SDK.
