{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "bun install",
  "devCommand": "next dev -p 3000",
  "github": {
    "silent": true
  },
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/scheduler/dispatch",
      "schedule": "*/5 * * * *"
    }
  ]
}
